# Demo environment — laptop, local FalkorDB via Docker, no GPU/SGLang needed
# Usage: cp .env.demo .env   (before starting the demo)

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=repo_insight
FLUSH_GRAPH_ON_INGEST=false

# Ingestion — fast settings for demo
SKIP_JEDI=true
SKIP_SUMMARIES=true
INGEST_CONCURRENCY=4

# Graph traversal depths
IMPACT_RADIUS_MAX_DEPTH=3
BLAST_RADIUS_MAX_DEPTH=4

# LLM — Streamlit chat won't work without this, but graph viz is fine without it
# Point to any OpenAI-compatible server you have (Ollama, etc.)
# Leave blank if you're only using Bob + the Graph Explorer tab
SGLANG_BASE_URL=http://localhost:11434/v1
SGLANG_API_KEY=EMPTY
LLM_MODEL=llama3

# Agent settings
AGENT_MAX_ITERATIONS=10
AGENT_TOOL_TIMEOUT_SECONDS=30
